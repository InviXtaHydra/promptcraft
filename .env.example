# Copy to .env and fill in. Never commit .env.

# PostgreSQL (docker compose reads POSTGRES_*; the app and Prisma read the URLs)
POSTGRES_USER=promptcraft
POSTGRES_PASSWORD=change-me
POSTGRES_DB=promptcraft
DATABASE_URL=postgresql://promptcraft:change-me@localhost:5435/promptcraft
# Integration tests run against this database (created by docker/postgres-init)
TEST_DATABASE_URL=postgresql://promptcraft:change-me@localhost:5435/promptcraft_test

# Only behind a proxy whose public origin differs from the request URL (CSRF Origin check)
# APP_ORIGIN=https://promptcraft.example


# --- Phase 2: AI (local only, no API keys) -----------------------------------------
# mock   = deterministic scripted NPCs, labelled "simulated" (tests, offline)
# ollama = a language model running on this machine: https://ollama.com
#          ollama pull qwen3:8b && ollama pull nomic-embed-text
DIALOGUE_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# NPC memory embeddings (768 dimensions): ollama = nomic-embed-text, hash = deterministic test embedder
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text
# Optional limits (defaults shown)
# AI_CALL_TIMEOUT_MS=90000
# AI_TURN_TIMEOUT_MS=180000
# AI_MAX_RETRIES=2
# AI_TURN_TOKEN_BUDGET=16000
